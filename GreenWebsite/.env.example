# أصل الـAPI الذي يقرأ منه الموقع بيانات البرامج والمبادرات والأثر.
# الطلب يخرج من خادم Next لا من متصفح الزائر، فلا يظهر هذا العنوان للعامة.
API_ORIGIN=http://127.0.0.1:4000

# العنوان العلني للموقع. يُستعمل في الروابط المطلقة داخل sitemap.xml
# وبطاقات المشاركة (Open Graph)، فلا بد أن يكون العنوان النهائي في الإنتاج.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
