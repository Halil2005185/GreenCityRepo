# أصل الـAPI الذي يقرأ منه الموقع بيانات البرامج والمبادرات والأثر.
# الطلب يخرج من خادم Next لا من متصفح الزائر، فلا يظهر هذا العنوان للعامة.
API_ORIGIN=http://127.0.0.1:4000

# العنوان العلني للموقع. يُستعمل في الروابط المطلقة داخل sitemap.xml
# وبطاقات المشاركة (Open Graph)، فلا بد أن يكون العنوان النهائي في الإنتاج.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# أصل الـAPI كما يراه متصفح الزائر. يستعمله إرسال الاستمارات والتطبيق
# الميداني (/app): الطلب يخرج من المتصفح لا من خادم الموقع كي يُحسب حدّ
# الطلبات وبصمة العنوان على المُرسِل نفسه. أضف أصل الموقع إلى CORS_ORIGINS
# في الباك‌اند.
#
# `localhost` لا `127.0.0.1`: كوكي جلسة التطبيق الميداني `SameSite=Strict`،
# والمتصفح يعدّ `localhost` و`127.0.0.1` موقعين مختلفين فلا يحفظها بينهما،
# فيخرج القائد من جلسته عند كل إعادة تحميل.
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000

# رمز Mapbox العام (يبدأ بـpk.) لخريطة الموقع الثابتة في بطاقة المتطوع.
# اختياري: بلا رمز تبقى البطاقة كاملة بزر «افتح في الخرائط» وبلا صورة.
# قيّده من حساب Mapbox بعنوان الموقع (URL restrictions)، ولا تضع هنا رمزًا
# سرّيًا (sk.) أبدًا: كل ما يبدأ بـNEXT_PUBLIC_ يُرسَل إلى متصفح الزائر.
NEXT_PUBLIC_MAPBOX_TOKEN=
