# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Local PostgreSQL. Replace the password after creating the local role.
DATABASE_URL=postgresql://greencities_app:CHANGE_ME@127.0.0.1:5432/greencities
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Use true in production when the database must be reachable before the API starts.
DATABASE_REQUIRED_ON_START=true

# Migrations and drizzle-kit use this when set; the app keeps using DATABASE_URL.
# Managed providers (Neon and friends) expose a pooled endpoint for the app and a
# direct one for tooling — DDL through a transaction pooler is not always safe.
# Leave empty for a plain local PostgreSQL.
# DIRECT_URL=

# The integration tests TRUNCATE every table, so they need their own database.
# The name must end with "_test" or the guard in test/helpers/database.ts refuses
# to run. Without this the suite skips instead of touching your dev data.
TEST_DATABASE_URL=postgresql://greencities_app:CHANGE_ME@127.0.0.1:5432/greencities_test

# Authentication
# Generate a fresh value per environment:  openssl rand -base64 32
# Rotating this secret invalidates every access token immediately.
JWT_ACCESS_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

AUTH_COOKIE_NAME=gc_refresh
# Leave empty on localhost. In production set the dashboard host, e.g. admin.greencities.sy
# AUTH_COOKIE_DOMAIN=
# Must stay true in production. Set false only for plain-HTTP local development.
AUTH_COOKIE_SECURE=false

AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15

INVITATION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=60

# Used to build invitation and password-reset links sent by email.
ADMIN_APP_URL=http://localhost:3001

# Email. Messages are queued in the outbox table inside the originating
# transaction, and a separate worker sends them: npm run worker
# Leave MAIL_ENABLED=false in development — the worker then logs the link
# instead of sending, so invitations and password reset work end to end
# without a verified domain.
MAIL_ENABLED=false
RESEND_API_KEY=
MAIL_FROM=Green Cities <no-reply@example.org>
MAIL_REPLY_TO=

OUTBOX_POLL_MS=5000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5

# File storage — Cloudflare R2 (S3-compatible).
# Leave blank in development: the API boots fine and only the upload route
# answers "storage is not configured". Uploads go browser -> R2 directly;
# the API only signs them, so these keys never reach the browser.
#
# Where each value comes from:
#   R2_ACCOUNT_ID        Cloudflare dashboard -> R2 -> account id in the S3 endpoint
#   R2_BUCKET            the bucket you create in R2
#   R2_ACCESS_KEY_ID     R2 -> Manage R2 API Tokens -> Object Read & Write
#   R2_SECRET_ACCESS_KEY shown once when the token is created — a secret
#   R2_PUBLIC_BASE_URL   the custom domain connected to the bucket
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_TTL_SECONDS=300
