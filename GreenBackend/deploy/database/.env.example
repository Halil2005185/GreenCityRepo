# يُنسخ إلى `.env` بجانب السكربتات على الخادم، ثم `chmod 600 .env`.
# تقرؤه: setup-native.sh وmigrate-from-neon.sh وbackup.sh وrestore.sh.
#
# منفصل عن `deploy/.env` عمدًا: ذاك يُحمَّل في حاويتي الـAPI والعامل، ومفاتيح
# سطل النسخ ورابط Neon لا مكان لهما في عملية تخدم الطلبات.
#
# القيم بلا علامات تنصيص وبلا مسافات.

# ─────────────────────────────── القاعدة ───────────────────────────────

# عنقود PostgreSQL 18 مخصص لهذا المشروع، لا العنقود الافتراضي `main`: الخادم
# يحمل مشاريع أخرى، والعنقود المخصص يُضبط ويُعاد تشغيله دون أن يمس غيره.
PG_CLUSTER=greencities
DB_NAME=greencities
DB_USER=greencities

# اتركها فارغة ليولّدها setup-native.sh ويكتبها هنا. وإن كتبتها بنفسك فبأحرف
# لا تحتاج ترميزًا داخل رابط:  openssl rand -hex 24
# لتغييرها لاحقًا: عدّلها هنا وأعد تشغيل setup-native.sh، ثم حدّث
# DATABASE_URL في deploy/.env وأعد تشغيل الـAPI.
DB_PASSWORD=

# مقبس ثانٍ على القرص لا على /run — السبب في greencities.conf. الـAPI والعامل
# والترحيل يركّبونه، فيجب أن يطابق PG_SOCKET_DIR في deploy/.env إن غيّرته.
PG_SOCKET_DIR=/var/lib/greencities-pgsocket

# ────────────────────────────── النسخ الاحتياطي ──────────────────────────────

# خارج شجرة الكود عمدًا: النشر يفك أرشيفًا فوق /opt/greencities، والنسخ لا
# يجوز أن تكون في طريق أي خطوة نشر.
BACKUP_DIR=/var/backups/greencities
BACKUP_KEEP_DAYS=14

# نسخة خارج الخادم. ليست تحسينًا: نسخة على قرص القاعدة نفسه لا تنجو من
# فقدان الخادم. اترك BACKUP_R2_BUCKET فارغًا لتبقى النسخ محلية وحدها.
#
# سطل جديد خاص، لا سطل الملفات المرفوعة: ذاك يُخدَم للعموم عبر
# R2_PUBLIC_BASE_URL، فنسخة تُكتب فيه تُنزَّل لمن يخمّن اسمها. أنشئ سطلًا بلا
# نطاق عام، ومفتاحًا بصلاحية Object Read & Write عليه وحده.
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_KEEP=60

# ───────────────────────────── النقل لمرة واحدة ─────────────────────────────

# رابط Neon كما يعرضه — النقطة المباشرة بلا `-pooler`، ومعه ?sslmode=require.
# لا يستعمله إلا migrate-from-neon.sh، وهو يقرأ من Neon ولا يكتب فيه شيئًا.
# امسحه بعد أن يعمل الموقع على القاعدة المحلية أيامًا.
NEON_DATABASE_URL=
