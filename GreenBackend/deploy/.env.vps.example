# متغيرات بيئة الإنتاج — انسخه إلى `deploy/.env` على الـVPS ولا تدفعه إلى Git.
#
#   cp deploy/.env.vps.example deploy/.env && chmod 600 deploy/.env
#
# الملف يُقرأ مرتين: يمرره Compose إلى الحاويات، ويستعمله Compose نفسه في
# تعويض قيم `${...}` داخل `compose.prod.yml`.

# ───────────────────────────── التطبيق ─────────────────────────────
NODE_ENV=production

# داخل الحاوية يجب أن يكون 0.0.0.0، وإلا لم يصل إليه المنفذ المنشور.
# العزل يأتي من نشر المنفذ على loopback المضيف لا من ربط العملية.
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api

# منفذ المضيف الذي يوجّه إليه Nginx. غيّره فقط عند تعارض.
API_PORT=4000

# قفزة وكيل واحدة (Nginx). إن وُضع Cloudflare بوضع proxy أمامه فالقفزات
# اثنتان، وقيمة 1 تجعل Express يقرأ IP الوسيط لا الزائر — وعليه تُبنى
# محاسبة rate limiting وقفل محاولات الدخول.
TRUST_PROXY=1

# الأصول المسموح لها بالطلبات المغيِّرة. أضف أي واجهة تنادي الـAPI فعلًا،
# ولا تضع نطاق الـAPI نفسه.
CORS_ORIGINS=https://gc-admin.evavolunteer.com,https://greencities.evavolunteer.com

# ─────────────────────────── قاعدة البيانات ───────────────────────────
#
# `postgres` هو اسم الخدمة في Compose لا مضيفًا خارجيًا. القاعدة لا تنشر
# منفذًا، فلا تُرى من خارج شبكة المشروع.
POSTGRES_DB=greencities
POSTGRES_USER=greencities_app
POSTGRES_PASSWORD=CHANGE_ME

# يجب أن تطابق الثلاثة أعلاه. رمّز كلمة المرور بترميز URL إن حوت رموزًا خاصة.
DATABASE_URL=postgresql://greencities_app:CHANGE_ME@postgres:5432/greencities

# الاتصال داخل شبكة Compose لا يخرج من الخادم، فلا حاجة إلى TLS. فعّله
# إن نُقلت القاعدة إلى خادم منفصل أو مزوّد مُدار.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_REQUIRED_ON_START=true

# ───────────────────────────── المصادقة ─────────────────────────────
#
# ولّد قيمة جديدة لهذه البيئة وحدها:  openssl rand -base64 32
# تغييرها يُبطل كل رموز الوصول فورًا.
JWT_ACCESS_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

AUTH_COOKIE_NAME=gc_refresh
AUTH_COOKIE_SECURE=true

# اتركه فارغًا عن قصد.
#
# ضبطه على `.evavolunteer.com` يسلّم كوكي التحديث لكل نطاق فرعي على
# المجال — بما فيها نطاقات لا علاقة لها بالمشروع وأي نطاق يُختطف لاحقًا.
# الكوكي مضبوط على مضيف اللوحة وحده، وهذا كافٍ ما دامت اللوحة تمرر `/api`
# على أصلها. اقرأ ملاحظة النطاقات في deploy/README.md قبل تغييره.
# AUTH_COOKIE_DOMAIN=

AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15

INVITATION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=60

# عليه تُبنى روابط الدعوة واستعادة كلمة المرور في البريد، فهو مضيف اللوحة
# لا مضيف الـAPI. خطؤه يعني رسائل بروابط لا تفتح شيئًا.
ADMIN_APP_URL=https://gc-admin.evavolunteer.com

# ─────────────────────────────── البريد ───────────────────────────────
#
# `false` يبقي الإدراج في صندوق الصادر ويوقف الإرسال. اتركه كذلك حتى
# يُتحقق من نطاق المرسل في Resend، فالدعوات ستنتظر في القائمة لا تضيع.
MAIL_ENABLED=false
RESEND_API_KEY=
MAIL_FROM=Green Cities <no-reply@evavolunteer.com>
MAIL_REPLY_TO=

OUTBOX_POLL_MS=5000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5
