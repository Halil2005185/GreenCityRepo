# متغيرات بيئة الإنتاج — انسخه إلى `deploy/.env` على الـVPS ولا تدفعه إلى Git.
#
#   cp deploy/.env.vps.example deploy/.env && chmod 600 deploy/.env
#
# الملف يُقرأ مرتين: يمرره Compose إلى الحاويات، ويستعمله Compose نفسه في
# تعويض قيم `${...}` داخل `compose.prod.yml`.

# ───────────────────────────── التطبيق ─────────────────────────────
NODE_ENV=production

# داخل الحاوية يجب أن يكون 0.0.0.0، وإلا لم يصل إليه المنفذ المنشور.
# العزل يأتي من نشر المنفذ على loopback المضيف لا من ربط العملية.
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api

# منفذ المضيف الذي يوجّه إليه Nginx. غيّره فقط عند تعارض.
API_PORT=4000

# قفزة وكيل واحدة (Nginx). إن وُضع Cloudflare بوضع proxy أمامه فالقفزات
# اثنتان، وقيمة 1 تجعل Express يقرأ IP الوسيط لا الزائر — وعليه تُبنى
# محاسبة rate limiting وقفل محاولات الدخول.
TRUST_PROXY=1

# الأصول المسموح لها بالطلبات المغيِّرة. أضف أي واجهة تنادي الـAPI فعلًا،
# ولا تضع نطاق الـAPI نفسه.
CORS_ORIGINS=https://gc-admin.evavolunteer.com,https://greencities.evavolunteer.com

# ─────────────────────────── قاعدة البيانات ───────────────────────────
#
# عنقود PostgreSQL 18 على هذا الخادم نفسه، عبر مقبس Unix تركّبه الحاويات —
# التجهيز والنقل من Neon في database/ و«قاعدة البيانات» في README.md.
#
# `localhost` في الرابط ليس اتصال شبكة: `host=` بعده يوجّه pg إلى مجلد المقبس.
# لكنه شرط، لأن التحقق من المتغيرات يمرّر الرابط على `new URL()`، وهذا يرفض
# رابطًا بمضيف فارغ (`...@/greencities`) فيسقط الـAPI عند البدء.
#
# المنفذ منفذ العنقود كما يطبعه setup-native.sh — 5432 إن لم يسبقه عنقود آخر.
# وكلمة المرور من database/.env، بأحرف لا تحتاج ترميزًا في رابط.
#
# لا DIRECT_URL: كان للنقطة المباشرة في Neon، وdrizzle-kit يرجع إلى
# DATABASE_URL في غيابه. وجوده بقيمة أخرى يُفشل deploy.sh عمدًا.
DATABASE_URL=postgresql://greencities:PASSWORD@localhost:5432/greencities?host=/var/run/postgresql&sslmode=disable

# المقبس لا يحمل TLS. والخيار `ssl` في كود التطبيق يسبق `sslmode` في الرابط،
# فـ`true` هنا يطلب TLS فيُرفض الاتصال.
DATABASE_SSL=false
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_REQUIRED_ON_START=true

# غيّره فقط إن غيّرته في database/.env — Compose يركّبه في الحاويات.
# PG_SOCKET_DIR=/var/lib/greencities-pgsocket

# ───────────────────────────── المصادقة ─────────────────────────────
#
# ولّد قيمة جديدة لهذه البيئة وحدها:  openssl rand -base64 32
# تغييرها يُبطل كل رموز الوصول فورًا.
JWT_ACCESS_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

AUTH_COOKIE_NAME=gc_refresh
AUTH_COOKIE_SECURE=true

# اتركه فارغًا عن قصد.
#
# ضبطه على `.evavolunteer.com` يسلّم كوكي التحديث لكل نطاق فرعي على
# المجال — بما فيها نطاقات لا علاقة لها بالمشروع وأي نطاق يُختطف لاحقًا.
# الكوكي مضبوط على مضيف اللوحة وحده، وهذا كافٍ ما دامت اللوحة تمرر `/api`
# على أصلها. اقرأ ملاحظة النطاقات في deploy/README.md قبل تغييره.
# AUTH_COOKIE_DOMAIN=

AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15

INVITATION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=60

# عليه تُبنى روابط الدعوة واستعادة كلمة المرور في البريد، فهو مضيف اللوحة
# لا مضيف الـAPI. خطؤه يعني رسائل بروابط لا تفتح شيئًا.
ADMIN_APP_URL=https://gc-admin.evavolunteer.com

# عنوان الموقع العام. عليه تُبنى روابط المتطوعين الشخصية (`/app/link`) ورابط
# استمارة التقييم في بطاقاتهم. بلا شرطة أخيرة. إن تُرك بلا قيمة رفض الخادم
# توليد الروابط: رابط إلى `localhost` يصل المتطوع ولا يفتح شيئًا.
PUBLIC_SITE_URL=https://greencities.evavolunteer.com

# عمر الرابط الشخصي بالأيام حين لا يحدّده المنسّق عند التوليد (1–365).
FIELD_LINK_TTL_DAYS=45

# ─────────────────────────────── البريد ───────────────────────────────
#
# `false` يبقي الإدراج في صندوق الصادر ويوقف الإرسال. اتركه كذلك حتى
# يُتحقق من نطاق المرسل في Resend، فالدعوات ستنتظر في القائمة لا تضيع.
MAIL_ENABLED=false
RESEND_API_KEY=
MAIL_FROM=المدن الخضراء <no-reply@evavolunteer.com>
MAIL_REPLY_TO=

OUTBOX_POLL_MS=5000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5

# ─────────────────────── تخزين الملفات (Cloudflare R2) ───────────────────────
# الرفع يذهب من متصفح الموظف إلى R2 مباشرة؛ الخادم يوقّعه فقط، فهذه المفاتيح
# لا تصل المتصفح أبدًا. اتركها فارغة ليعمل كل شيء عدا الرفع.
R2_ACCOUNT_ID=29e2e2cb2ab6b2023a416978e881c65b
R2_BUCKET=greencities-media
# المفتاحان سرّان: يُملآن في .env على الجهاز أو الخادم، ولا يُودَعان في Git.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://media.evavolunteer.com
