NODE_ENV=production
HOST=127.0.0.1
PORT=4000
API_PREFIX=/api
TRUST_PROXY=1
CORS_ORIGINS=https://example.org,https://admin.example.org

# If PostgreSQL is on the same VPS, keep it bound to loopback and SSL can stay false.
DATABASE_URL=postgresql://greencities_app:CHANGE_ME@127.0.0.1:5432/greencities
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_REQUIRED_ON_START=true
