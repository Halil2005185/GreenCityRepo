// ────────────────────────────── الصلاحيات والحسابات ──────────────────────────

/// أدوار المنصة — دور واحد لكل حساب.
/// «شريك تنفيذي» و«شريك إعلامي» ليسا دورين بل صفتَي شراكة (PartnershipType)
/// على مستوى الجهة + قدرات (PartnerCapability) على مستوى الممثل.
enum UserRole {
  /// المشرف العام — فريق إيفا الأساسي، صلاحية كاملة.
  SUPER_ADMIN
  /// مدير — الشركاء والطلبات والمبادرات والمتطوعون.
  ADMIN
  /// محرر — المحتوى فقط (مبادرات، تحديثات، وسائط).
  EDITOR
  /// ممثل جهة شريكة — كل وصوله عبر PartnerContact.
  PARTNER_USER
  /// متطوع — ملفه الشخصي وطلباته فقط.
  VOLUNTEER
}

/// دور الممثل داخل جهته الشريكة.
enum PartnerRole {
  PARTNER_ADMIN
  PARTNER_CONTRIBUTOR
  PARTNER_VIEWER
}

/// قدرات دقيقة داخل الجهة — هي ما يُفحص فعلياً في التفويض.
enum PartnerCapability {
  MANAGE_ORG_PROFILE
  MANAGE_DISPLAY_CONSENT
  /// شريك إعلامي
  UPLOAD_MEDIA
  /// شريك إعلامي
  PUBLISH_UPDATES
  /// شريك تنفيذي
  LOG_FIELD_ACTIVITY
  /// شريك تنفيذي
  SUBMIT_IMPACT
  VIEW_SCOPED_REPORTS
}

enum UserStatus {
  PENDING_INVITE
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

