// إعداد Worker لوحة التحكم على Cloudflare.
//
// البناء ليس هنا بل في `cf:build` داخل package.json، والنشر يستدعيه قبله.
//
// السبب أن `wrangler deploy` في مشروع OpenNext لا ينشر بنفسه: يكتشف
// المحوّل ويفوّض الأمر إلى `opennextjs-cloudflare deploy`، وهذا يقرأ
// `.open-next/.build/open-next.config.edge.mjs` جاهزًا ولا يبنيه. فحقل
// `build.command` هنا لا يُقرأ أصلًا على هذا المسار — وُضع سابقًا ظنًّا
// أنه يكفي، فسقط النشر بـ"Could not find compiled Open Next config".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "greencities",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "greencities" }
  ],
  "observability": { "enabled": true }
}
