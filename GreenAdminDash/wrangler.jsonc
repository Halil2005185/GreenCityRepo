// إعداد Worker لوحة التحكم على Cloudflare.
//
// البناء ليس هنا بل في `cf:build` داخل package.json، والنشر يستدعيه قبله.
//
// السبب أن `wrangler deploy` في مشروع OpenNext لا ينشر بنفسه: يكتشف
// المحوّل ويفوّض الأمر إلى `opennextjs-cloudflare deploy`، وهذا يقرأ
// `.open-next/.build/open-next.config.edge.mjs` جاهزًا ولا يبنيه. فحقل
// `build.command` هنا لا يُقرأ أصلًا على هذا المسار — وُضع سابقًا ظنًّا
// أنه يكفي، فسقط النشر بـ"Could not find compiled Open Next config".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "greencities",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "greencities" }
  ],
  "observability": { "enabled": true },
  // متغير وقت التشغيل مطابق لما أُضيف في لوحة Cloudflare، كي لا يمحوه
  // `wrangler deploy` التالي. لكنه لا يصل إلى المتصفح: Next يضمّن قيم
  // `NEXT_PUBLIC_*` في الحزمة وقت `next build`، فالقيمة التي تعمل بها
  // الخريطة فعلًا تُقرأ من `.env.production`. أيّ تغيير للرمز يكون في
  // الموضعين معًا.
  "vars": {
    "NEXT_PUBLIC_MAPBOX_TOKEN": "pk.eyJ1IjoiZXZhdm9sdW4iLCJhIjoiY211Ymo0cXViMXJucDJ4czhxOGpoeHJqNiJ9.HIiCXGwWZrfP2QOayRoRBw"
  }
}
