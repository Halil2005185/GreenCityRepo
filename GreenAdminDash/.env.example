# عنوان الـAPI أثناء التطوير. `next.config.ts` يمرّر /api إليه، فتبقى
# اللوحة والـAPI على أصل واحد — وهو شرط عمل كوكي SameSite=Strict.
# في الإنتاج يقوم Nginx بهذا الدور ولا يُستعمل هذا المتغير.
API_ORIGIN=http://127.0.0.1:4000

# يجب أن يطابق AUTH_COOKIE_NAME في الباك‌اند. يُقرأ في middleware.ts للتوجيه فقط.
NEXT_PUBLIC_AUTH_COOKIE_NAME=gc_refresh

# عنوان الموقع العام. منه يُبنى رابط التسجيل الذي تنسخه اللوحة لكل
# استمارة منشورة: <العنوان>/join/<معرّف الاستمارة>.
NEXT_PUBLIC_SITE_URL=https://greencities.evavolunteer.com

# رمز Mapbox العام (يبدأ بـ pk.) للخريطة واختيار المواقع في النماذج.
# علنيٌّ بطبيعته لأنه يصل المتصفح، فالحماية في تقييده من حساب Mapbox
# بعناوين اللوحة وحدها: نطاق الإنتاج، وعنوان workers.dev، وlocalhost:3000.
# لا يوضع هنا رمز سري (sk.) أبدًا. يُضمَّن وقت البناء، فغيابه عند البناء
# يُظهر مكان الخريطة رسالة تشرح ذلك ويُبقي إدخال الإحداثيات يدويًا.
NEXT_PUBLIC_MAPBOX_TOKEN=